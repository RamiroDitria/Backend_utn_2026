            ],
            "url": "{{gatewayUrl}}/api/vehiculos/{{vehiculoId2}}",
            "description": "RN-04 - Confirma que, al no reconocer vPIC el VIN, el vehículo quedó con datosVerificados=false y con el motor/combustible cargados a mano."
          },
          "event": [
            {
              "listen": "test",
