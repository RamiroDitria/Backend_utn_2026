                  "const json = pm.response.json();",
                  "pm.test('datosVerificados es false', () => pm.expect(json.datosVerificados).to.eql(false));",
                  "pm.test('motor cargado a mano', () => pm.expect(json.motor).to.eql('2.0 4 cil.'));"
                ]
              }
            }
          ]
        }
